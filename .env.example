NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ENABLE_DEMO_DATA="false"
# Only trust client IP headers when a controlled reverse proxy overwrites them.
TRUST_PROXY="false"

# Server-side delivery for Trimurthi Connect enquiries.
# Use a Resend API key, verified sender address, and monitored recipient address.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
CONNECT_REQUEST_TO=""

# Private S3-compatible storage for optional support-request documents.
# Keep this bucket private, encrypted, and scoped to support-requests/*.
# Setup, access, CORS and retention requirements: docs/SUPPORT-REQUEST-UPLOADS.md
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional for S3-compatible providers; leave blank for AWS S3.
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
